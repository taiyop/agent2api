{
  "name": "agent2api",
  "version": "0.1.0",
  "description": "Expose authenticated local AI agents through pluggable LLM API-compatible interfaces.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent2api": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taiyop/agent2api.git"
  },
  "keywords": [
    "openai-compatible",
    "ai-agent",
    "headless-core",
    "codex",
    "claude-code",
    "sse"
  ],
  "dependencies": {
    "@headless-core/core": "^0.1.5",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "openai": "^5.16.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
